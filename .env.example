# --- Modo de execução -------------------------------------------------------
# demo: FakeEmbeddingProvider + InMemoryVectorStore + FakeLLMClient (100% offline)
# prod: Voyage AI + Postgres/pgvector + Claude API
APP_MODE=demo
LOG_LEVEL=INFO

# Token exigido no header X-Admin-Token para as rotas /admin/* (mínimo 8 caracteres)
ADMIN_TOKEN=change-me-admin-token

# Pasta com as políticas (.md/.txt/.pdf). Em demo é ingerida no start da API.
CORPUS_DIR=corpus
WEB_DIST_DIR=web/dist
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM (prod) -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=2048

# --- Embeddings (prod) ------------------------------------------------------
VOYAGE_API_KEY=pa-your-voyage-key-here
VOYAGE_MODEL=voyage-3
EMBEDDING_DIM=1024

# --- Banco (prod) -----------------------------------------------------------
DATABASE_URL=postgresql://policy:policy@localhost:5432/policy_rag

# --- Retrieval / guardrails -------------------------------------------------
TOP_K_VECTOR=8
TOP_K_LEXICAL=8
TOP_K_FINAL=4
MIN_RELEVANCE_SCORE=0.30
FAQ_MATCH_THRESHOLD=0.80
MAX_QUESTION_CHARS=1000
